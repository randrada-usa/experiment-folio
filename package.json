{
  "name": "experiment-folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests index.html projects/index.html certifications/index.html package.json vite.config.ts tsconfig.json",
    "format:check": "prettier --check src tests index.html projects/index.html certifications/index.html package.json vite.config.ts tsconfig.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
